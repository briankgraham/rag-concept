# Required
OPENAI_API_KEY=sk-...

# PostgreSQL connection string for the web app's users/sessions/pto_cache/
# doc_sources/doc_chunks tables. Matches docker-compose.yml's postgres
# service — run `docker compose up -d` for a local Postgres with pgvector.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simple_rag

# Web server port
PORT=3000

# Session cookie lifetime, in milliseconds (default: 7 days)
SESSION_TTL_MS=604800000

# How long a cached ADP PTO balance is considered fresh, in milliseconds (default: 15 minutes)
PTO_CACHE_TTL_MS=900000

# Max rows of conversation history kept per user (default: 20, i.e. 10
# question/answer exchanges) — older turns are pruned on every append.
MAX_CONVERSATION_MESSAGES=20

# Use mock implementations of Okta SSO and the ADP API instead of the real
# services. Both default to true — there is no live Okta tenant or ADP
# credentials configured yet. Do not set these to false until real
# implementations exist in src/auth/okta-client.real.ts and
# src/hr/adp-client.real.ts.
OKTA_MOCK=true
ADP_MOCK=true

# Enables verbose LLM request/response and orchestrator tool-call logging.
DEBUG=false

# Comma-separated list of frontend origins allowed to call this API
# cross-origin with the session cookie attached (e.g.
# https://app.example.com,https://staging.example.com). Leaving this unset
# means no cross-origin browser caller is allowed — same-origin requests
# are unaffected either way. Set this to the web/ frontend's origin
# locally, e.g. http://localhost:5173.
ALLOWED_ORIGIN=

# Where the separate web/ frontend (its own server, see web/) is served
# from. src/auth/auth.routes.ts's /auth/callback redirects here once
# login completes. Defaults to Vite's own default dev port.
FRONTEND_URL=http://localhost:5173
