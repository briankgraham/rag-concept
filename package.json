{
  "name": "simple-rag-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "rag": "dist/cli/rag-cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/cli/rag-cli.js",
    "server": "node dist/server.js",
    "dev": "nodemon --legacy-watch --watch src --ext ts --exec tsx src/server.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "test": "npm run build && OPENAI_API_KEY=test-key-for-unit-tests node --test --test-concurrency=1 dist/__tests__/*.test.js",
    "test:coverage": "npm run build && OPENAI_API_KEY=test-key-for-unit-tests c8 node --test --test-concurrency=1 dist/__tests__/*.test.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "eval:tools": "npm run build && node dist/eval/tool-selection-eval.js",
    "eval:retrieval": "npm run build && node dist/eval/retrieval-eval.js"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "dotenv": "^17.4.2",
    "gpt-tokenizer": "^4.0.0",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "openai": "^4.21.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0"
  }
}
